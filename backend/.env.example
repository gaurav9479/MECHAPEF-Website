PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_TEST_URI=mongodb://localhost:27017/mechapef-test

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

FRONTEND_URL=http://localhost:5173
# Public URL used inside emails while the API runs locally
EMAIL_FRONTEND_URL=https://mechapef-website.vercel.app

IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_gmail@gmail.com
ANNOUNCEMENT_EMAIL_DELAY_MS=45000

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,mp4,mov

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

SESSION_SECRET=your_session_secret_here

# Redis Configuration (BullMQ Queues & Background Workers via TCP)
ENABLE_REDIS=true
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Upstash Redis REST API (For Serverless & Live Voting Engine)
UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
